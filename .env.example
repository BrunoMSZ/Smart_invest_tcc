# ==========================================
# SMARTINVEST AI - VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha suas chaves
# NUNCA suba o arquivo .env para o GitHub!
# ==========================================

# OpenRouter API Key (para modelos de IA gratuitos ou pagos)
# Obtenha sua chave gratuita em https://openrouter.ai/keys
OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# NewsAPI Key (opcional, para notícias do mercado em tempo real)
# Obtenha em https://newsapi.org/
NEWS_API_KEY=sua_chave_newsapi_aqui

# JWT Secret Key (usado para criptografar tokens de sessão)
JWT_SECRET_KEY=smartinvest-secret-key-producao-altere-me-2026
